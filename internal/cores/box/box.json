    "rules": [
      {
        "preferred_by": "dns-mdns",
        "action": "route",
        "server": "dns-mdns"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "rule_set": "geosite-private"
          },
          {
            "preferred_by": "dns-local"
          }
        ],
        "server": "dns-local"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "query_type": "AAAA"
          },
          {
            "default_interface_address": [
              "2000::/3"
            ],
            "invert": true
          }
        ],
        "action": "reject"
      },
      {
        "clash_mode": "IPv4Only",
        "query_type": "AAAA",
        "action": "reject"
      },
      {
        "query_type": [
          "HTTPS",
          "SVCB"
        ],
        "action": "reject"
      },
      {
        "clash_mode": "Global",
        "server": "dns-final"
      },
      {
        "rule_set": "@geosite-should-block",
        "action": "reject"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "rule_set": [
              "geosite-category-ntp",
              "@geosite-direct",
              "@geosite-akamai@cn",
              "@geosite-steam@cn",
              "@geosite-google-play@cn",
              "@geosite-geolocation-cn"
            ]
          },
          {
            "port": [
              25,
              67,
              68,
              110,
              123,
              143,
              179,
              465,
              546,
              547,
              587,
              995,
              8899,
              8733
            ]
          }
        ],
        "action": "route",
        "server": "dns-cn"
      },
      {
        "rule_set": [
          "geosite-youtube"
        ],
        "action": "route",
        "server": "dns-youtube"
      },
      {
        "rule_set": [
          "geosite-google"
        ],
        "action": "route",
        "server": "dns-google"
      },
      {
        "rule_set": [
          "@geosite-category-ai-!cn",
          "geosite-category-ai-!cn"
        ],
        "action": "route",
        "server": "dns-ai"
      },
      {
        "rule_set": [
          "@geosite-category-dev",
          "geosite-github",
          "geosite-gitlab"
        ],
        "action": "route",
        "server": "dns-git"
      },
      {
        "rule_set": [
          "geosite-apple"
        ],
        "action": "route",
        "server": "dns-apple"
      },
      {
        "rule_set": [
          "geosite-microsoft"
        ],
        "action": "route",
        "server": "dns-microsoft"
      },
      {
        "rule_set": [
          "geosite-category-entertainment",
          "geosite-category-social-media-!cn",
          "geosite-reddit",
          "@geosite-cloudflare-challenge"
        ],
        "action": "route",
        "server": "dns-entertainment"
      },
      {
        "rule_set": "geosite-cn",
        "server": "dns-local"
      },
      {
        "rule_set": [
          "@geosite-download",
          "geosite-category-game-platforms-download",
          "geosite-category-android-app-download",
          "geosite-curseforge"
        ],
        "action": "route",
        "server": "dns-download"
      },
      {
        "rule_set": [
          "geosite-geolocation-!cn"
        ],
        "action": "route",
        "server": "dns-final"
      },
      {
        "invert": true,
        "query_type": [
          "A",
          "AAAA"
        ],
        "action": "route",
        "server": "dns-cn"
      },
      {
        "tag": "resolve-evaluate-ecs",
        "action": "evaluate",
        "server": "dns-ecs",
        "client_subnet": "0.0.0.0/0"
      },
      {
        "match_response": "resolve-evaluate-ecs",
        "response_rcode": "NOERROR",
        "ip_accept_any": true,
        "invert": true,
        "action": "respond"
      },
      {
        "match_response": "resolve-evaluate-ecs",
        "rule_set": [
          "geoip-cn",
          "@geoip-direct"
        ],
        "ip_accept_any": true,
        "ip_is_private": true,
        "response_rcode": "NOERROR",
        "action": "respond"
      }
    ],
    "final": "dns-final",
    "reverse_mapping": true,
    "optimistic": {
      "enabled": true,
      "timeout": "3d"
    }
  },
  "route": {
    "rules": [
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "protocol": "dns"
          },
          {
            "inbound": [
              "dns-in"
            ]
          },
          {
            "port": 53
          }
        ],
        "action": "hijack-dns"
      },
      {
        "inbound": [
          "mixed-in"
        ],
        "action": "resolve",
        "strategy": "prefer_ipv4"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "network": "icmp"
          },
          {
            "port": [
              25,
              67,
              68,
              110,
              123,
              143,
              179,
              465,
              546,
              547,
              587,
              995,
              8899,
              8733
            ]
          },
          {
            "ip_is_private": true
          }
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "default_interface_address": [
              "2000::/3"
            ],
            "invert": true
          },
          {
            "ip_version": 6
          }
        ],
        "action": "reject"
      },
      {
        "ip_version": 6,
        "clash_mode": "IPv4Only",
        "action": "reject"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "outbound": "🙋 Select"
      },
      {
        "rule_set": "@geoip-telegram@dc5",
        "outbound": "✈️ TelegramDC5(AP)"
      },
      {
        "rule_set": "@geoip-telegram@dc1",
        "outbound": "✈️ TelegramDC1(NA)"
      },
      {
        "rule_set": "@geoip-telegram@dc4",
        "outbound": "✈️ TelegramDC4(EU)"
      },
      {
        "rule_set": [
          "@geoip-direct",
          "geoip-cn"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "port": [
          80,
          443
        ],
        "network": "udp",
        "action": "reject"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "inbound": [
              "mixed-in"
            ],
            "invert": true
          }
        ],
        "action": "sniff",
        "sniffer": [
          "http",
          "tls",
          "quic",
          "ssh"
        ],
        "timeout": "50ms"
      },
      {
        "rule_set": "@geosite-should-block",
        "action": "reject"
